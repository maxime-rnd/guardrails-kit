# Copy this file to .env and adjust the values for your OpenAI-compatible API.
# These Ollama settings work when Ollama is running locally and the models are pulled.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:0.5b
OPENAI_EMBEDDING_MODEL=nomic-embed-text

# For the OpenAI API, remove OPENAI_BASE_URL and use your own API key instead:
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
